{
  "name": "seosona-content",
  "private": true,
  "description": "SEOSONA Content — bound to SEOSONA OS via seosona.project.json",
  "scripts": {
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "runtime:start": "node runtime/index.mjs",
    "runtime:verify": "node --test tests/runtime-*.test.mjs",
    "facebook:companion": "node scripts/companion/facebook-companion.mjs",
    "facebook:audit": "node scripts/audit/facebook-factory-audit.mjs",
    "facebook:audit:strict": "node scripts/audit/facebook-factory-audit.mjs --strict",
    "facebook:verify": "npm test && npm run seosona:doctor && npm run facebook:audit",
    "facebook:verify:release": "npm test && npm run seosona:doctor && npm run facebook:audit:strict",
    "seosona:doctor": "node scripts/seosona-project.mjs doctor",
    "seosona:log": "node scripts/seosona-project.mjs log",
    "providers:verify": "node --test tests/provider-*.test.mjs tests/browser-provider-adapter.test.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  }
}
